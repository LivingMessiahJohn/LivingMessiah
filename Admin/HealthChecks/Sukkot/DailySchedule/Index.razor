@page "/HealthCheck/DailySchedule/Index"

@using Admin.Security.Policies
@using Microsoft.AspNetCore.Components.Authorization
@using PageNav = Admin.Enums.Nav

<PageHeader PageEnum="PageNav.HealthChecks" />

<AuthorizeView Policy=@Authentication.Name>
  <Authorized>
    <Alert AlertType="alert-success" Alignment="Alert.AlignmentEnum.End"><small>Authorized: Policy: @Authentication.Name</small></Alert>
    <EnumTable />
  </Authorized>
  <NotAuthorized>
    <div class="alert alert-warning text-end" role="alert">
      <small>Not Authorized; Policy: @Authentication.Name</small>
    </div>
    <LoginRedirectCard ReturnTitle="@PageNav.HealthChecks.Title" ReturnUrl=@PageNav.HealthCheckDailySchedule.Index />
  </NotAuthorized>
</AuthorizeView>

@code {

}
