
<div class="container mt-5">
  <div class="card mx-auto border-warning border-3" style="width: 18rem;">

    <div class="card-header text-center fs-3">Not Authorized</div>
    <div class="card-body text-center">
      <p class="fs-5">
        To view...<br />
        
        <b>@ReturnTitle</b>
        <br />you need to be logged in.
      </p>
    </div>
    <div class="card-footer text-end fs-3"><LoginRedirectButton ReturnUrl="@ReturnUrl" /></div>

  </div>
</div>

@code {
  // @* <b>@NavGroup!.Title</b> *@
  //[Parameter, EditorRequired] public NavGroup? NavGroup { get; set; }
  //[Parameter, EditorRequired] public Enums.Nav? MenuBar { get; set; }
  
  [Parameter, EditorRequired] public string? ReturnTitle { get; set; }
  [Parameter, EditorRequired] public string? ReturnUrl { get; set; }
}
