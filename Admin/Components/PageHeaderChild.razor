
@using NavEnums = Admin.Enums.Nav;

<PageTitle>
	@if (String.IsNullOrEmpty(PageTitle))
	{
		@NavEnum.Title
	}
	else
	{
		@PageTitle
	}
</PageTitle>

<div class="d-print-none pb-n1 mt-2 mb-4 @BorderCSS">
	<div class="fs-3 text-center"><i class="@NavEnum.Icon"></i>&nbsp;&nbsp;@NavEnum.Title</div>
</div>

@code {
	[Parameter, EditorRequired] public NavEnums NavEnum { get; set; }
	[Parameter] public string? PageTitle { get; set; }
	[Parameter] public string? BorderCSS { get; set; } = "border-bottom border-info";
}
