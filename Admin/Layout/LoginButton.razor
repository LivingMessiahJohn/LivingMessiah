@using AccountEnum = Admin.Enums.Account
@using NavGroupEnum = Admin.Enums.NavGroup

@inject NavigationManager NavigationManager
@inject ILogger<LoginButton>? Logger

<button type="button"
				class="btn btn-xs btn-outline-info float-end text-black-50 me-2"
				@onclick="ButtonClick">
		<u>@AccountEnum.Login.Title</u> <i class="@AccountEnum.Login.Icon"></i>
</button>

@code {
	private void ButtonClick()
	{
		Logger!.LogInformation("{Method}, LoginIndex: {LoginIndex}, ReturnURL: {ReturnURL}"
		, nameof(ButtonClick), AccountEnum.Login.Index, @NavGroupEnum.Home.Index);
		NavigationManager!.NavigateTo($"{AccountEnum.Login.Index}?returnUrl={@NavGroupEnum.Home.Index}", true);
	}
}