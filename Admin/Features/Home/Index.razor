@page "/"

@using Admin.Security.Constants
@using Microsoft.AspNetCore.Components.Authorization
@using RoleGroup = Admin.Security.Enums.RoleGroup;

@using PageNav = Admin.Enums.Nav
<PageHeader PageEnum="PageNav.Home" />

@* <div class="alert alert-dark " role="alert"> </div> *@


<AuthorizeView Policy=@RoleGroup.EmailVerifiedWithAtLeastOneRole>
	<Authorized>
		<NavTree />
	</Authorized>
	<NotAuthorized>
		<Alert AlertType="alert-warning">Not Authorized, Login Required</Alert>
	</NotAuthorized>
</AuthorizeView>
