@using Admin.Enums
@using Admin.Security
@using Microsoft.AspNetCore.Components.Authorization

@inject IToastService? Toast
@inject NavigationManager NavigationManager
@inject ILogger<NavTree>? Logger

<div class="@PanelClass">
  <ul class="nav flex-column list-unstyled mb-0">
    @foreach (var item in Items)
    {
      <li class="nav-item">
        <div class="d-flex align-items-center gap-1 py-1">

          @* Expand / Collapse toggle (only for folders) *@
          @if (item.IsFolder)
          {
            <button class="btn btn-sm btn-link p-0 text-decoration-none"
                    @onclick="() => Toggle(item)"
                    @onclick:stopPropagation="true"
                    title="@(item.IsExpanded ? "Collapse" : "Expand")">
              <i class="fas @(item.IsExpanded ? "fa-caret-down" : "fa-caret-right")"></i>
            </button>
          }
          else
          {
            <span class="btn btn-sm p-0" style="width: 1.25rem;"></span> @* spacer *@
          }

          @* Icon *@
          <i class="@(item.IsFolder && item.IsExpanded ? item.OpenIconClass : item.IconClass)"></i>

          @* Clickable label *@
          <button class="btn btn-lg text-start p-0 ms-1"
                  @onclick="() => HandleClick(item)"
                  title="@item.Title">
            @item.Text
          </button>
        </div>

        @* Recursive children — indented wrapper keeps siblings from looking nested *@
        @if (item.IsFolder && item.IsExpanded)
        {
          <div class="nav-tree-branch ms-3 ps-2">
            <NavTree Items="item.Children"
                        IsRoot="false" />
          </div>
        }
      </li>
    }
  </ul>
</div>

@code {
  [Parameter] public List<NavTreeItem> Items { get; set; } = new();
  [Parameter] public bool IsRoot { get; set; } = true;
  [CascadingParameter] private Task<AuthenticationState>? authenticationState { get; set; }

  private string? PanelClass => IsRoot ? "nav-tree-panel" : null;

  protected override async Task OnInitializedAsync()
  {
    // Because this component `NavTree` is being called recursively,
    // we want `OnInitializedAsync` to only execute once
    if (!IsRoot)
    {
      return;
    }

    /*
      use of the `[]` is a c# 12 collection expression (AKA a collection literal); it's equivalent to...
      `Items = new List<NavTreeItem> { Map(Nav.Home) };`
    */
    Items = [Map(Nav.Home)];

    if (authenticationState is null)
    {
      Logger?.LogWarning("{Method} {Message}", nameof(OnInitializedAsync), "authenticationState is null");
    }

    var user = authenticationState is null ? null : (await authenticationState).User;
    var userRoles = NavRoleAuthorization.GetUserRoleBitmask(user);
    Items = Items
      .Select(item => FilterAuthorized(item, userRoles))
      .Where(item => item is not null)
      .Cast<NavTreeItem>()
      .ToList();

    if (!Items.Any())
    {
      Logger?.LogWarning("{Method} {Message}", nameof(OnInitializedAsync), "authorized nav tree is empty");
    }
  }

  // Map represents the whole list of the tree and it's branches
  private static NavTreeItem Map(Nav nav) => new()
  {
    Text = nav.Title,
    Title = nav.Title,
    Index = nav.Index,
    IconClass = nav.IsFolder ? FolderConstants.FolderIcon : nav.Icon,
    OpenIconClass = "far fa-folder-open",
    IsExpanded = nav.ExpandByDefault,
    RequiredRoles = nav.RequiredRoles,
    Children = Nav.List
      .Where(c => c.Parent == nav.Value)
      .OrderBy(c => c.Sort)
      .ThenBy(c => c.Value)
      .Select(Map)
      .ToList()
  };

  private static NavTreeItem? FilterAuthorized(NavTreeItem item, int userRoles)
  {
    if (!NavRoleAuthorization.HasRequiredRole(item.RequiredRoles, userRoles))
    {
      return null;
    }

    item.Children = item.Children
      .Select(child => FilterAuthorized(child, userRoles))
      .Where(child => child is not null)
      .Cast<NavTreeItem>()
      .ToList();

    // Prefer hide empty folders (no route and no remaining children).
    if (string.IsNullOrWhiteSpace(item.Index) && item.Children.Count == 0)
    {
      return null;
    }

    return item;
  }

  private void HandleClick(NavTreeItem item)
  {
    if (item.IsFolder)
    {
      Toggle(item);
      return;
    }

    if (string.IsNullOrWhiteSpace(item.Index))
    {
      Toast!.ShowInfo($"No route for: {item.Text}");
      return;
    }

    NavigationManager.NavigateTo(item.Index);
  }

  private void Toggle(NavTreeItem item)
  {
    item.IsExpanded = !item.IsExpanded;
  }
}
