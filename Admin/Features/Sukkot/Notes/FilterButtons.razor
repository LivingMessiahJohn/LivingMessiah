@using FilterEnums = Admin.Features.Sukkot.Notes.Enums.Filter

 <div class="d-print-none mb-2">
	<div class="container d-flex justify-content-end mt-2">

		@foreach (var item in FilterEnums.List.OrderBy(o => o.Value))
		{
			<button @onclick="@(() => OnButtonClicked(item))"
							class="btn @item.CssTextColor btn-sm @ActiveFilter(item)">
				@item.Name &nbsp;<i class="fas fa-chevron-circle-right"></i>
			</button>
		}

	</div>
</div>

@code {
	[Parameter, EditorRequired] public required FilterEnums? FilterEnum { get; set; }
	[Parameter] public EventCallback<FilterEnums> OnFilterSelected { get; set; }

	public string ActiveFilter(FilterEnums filter) => filter == FilterEnum ? "active" : "";
	
	private void OnButtonClicked(FilterEnums filter)
	{
		OnFilterSelected.InvokeAsync(filter); 
	}
}
