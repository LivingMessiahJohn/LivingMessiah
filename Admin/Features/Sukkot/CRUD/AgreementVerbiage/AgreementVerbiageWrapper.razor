@using MenuBarEnums = Admin.Features.Sukkot.Enums.MenuBar;
@using StepEnums = RCL.Features.Sukkot.Enums.Step


<PageTitle>@MenuBarEnums.AgreementVerbiage.Title</PageTitle>
<CRUDHeader MenuBar="@MenuBarEnums.AgreementVerbiage" OnActionShowRegistrationList="ReturnedActionShowRegistrationList" />

<div class="card mt-0 mb-3">
	<div class="card-body border-info">
		<p>
			This is a mock-up of the legal verbiage that is shown to new registrants. This is
			<b>Step @StepEnums.SignAgreement.Value | <i class="@StepEnums.SignAgreement.Icon"></i> @StepEnums.SignAgreement.Text</b>
			in the registration process.
			It also includes the buttons to show the full process of compliance.
			Note, clicking the buttons will not actually be recorded.
		</p>
	</div>

	<div class="card-body border-info">
		<p>
			Should something like this be included? <br />
			<b>If a conflict arises the decisions will be made by the Elders and those decisions are final.</b>
			<br /><br />
			I think there should be a reference to the process of Matthew 18 included as well.
		</p>
	</div>

</div>

<h4 class="mb-3">To register for Sukkot, you must complete these steps</h4>

<div class="card mt-0 mb-3">
	<div class="card-body bg-light">
		<VerbiageText />
		<YesNoButtonsMockup EmailParm="FAKE@EMAIL" OnActionCompleted="ReturnedActionCompleted" />
	</div>
</div>


@code {
	[Parameter, EditorRequired] public EventCallback OnActionCompleted { get; set; }
	[Parameter, EditorRequired] public EventCallback OnActionShowRegistrationList { get; set; }

	private void ReturnedActionCompleted()
	{
		//Logger!.LogDebug("{Method}", nameof(ReturnedActionCompleted));
		OnActionCompleted.InvokeAsync();
	}
	private void ReturnedActionShowRegistrationList()
	{
		//Logger!.LogDebug("{Method}", nameof(ReturnedActionShowRegistrationList));
		OnActionShowRegistrationList.InvokeAsync();
	}
}
