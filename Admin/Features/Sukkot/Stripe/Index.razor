@page "/SukkotDashboard/StripeTable"

@using RoleGroup = Admin.Security.Enums.RoleGroup;
@using MenuBarEnums = Admin.Features.Sukkot.Enums.MenuBar;
@using Microsoft.AspNetCore.Components.Authorization
@using Admin.Features.Sukkot.Dashboard

<AuthorizeView Policy=@RoleGroup.Sukkot>
  <Authorized>
    
    <PageTitle>@MenuBarEnums.StripeTable.Title</PageTitle>
    <DashboardHeader MenuBar="@MenuBarEnums.StripeTable" />
    <StripeTable />

  </Authorized>
  <NotAuthorized>
    <LoginRedirectCard ReturnTitle="@Nav.SukkotDashboard.Title" ReturnUrl=@Nav.SukkotDashboard.Index />
    <div class="alert alert-warning text-end" role="alert">
      <small>Not Authorized; Role Group Policy: @RoleGroup.Sukkot</small> 
    </div>
  </NotAuthorized>
</AuthorizeView>
