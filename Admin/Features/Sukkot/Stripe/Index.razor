@using RoleGroup = Admin.Security.Enums.RoleGroup;

@page "/Sukkot/StripeTable"

@using Admin.Security.Constants
@using MenuBarEnums = Admin.Features.Sukkot.Enums.MenuBar;
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Policy=@RoleGroup.Sukkot>
  <Authorized>
    <PageHeaderMenubar MenuBarEnum=MenuBarEnums.StripeTable />
    <StripeTable />
  </Authorized>
  <NotAuthorized>
    <LoginRedirectCard Nav="Nav.Sukkot" ReturnUrl=@Nav.Sukkot.Index />
    <div class="alert alert-warning text-end" role="alert">
      <small>Not Authorized; Role Group Policy: @RoleGroup.Sukkot</small> 
    </div>
  </NotAuthorized>
</AuthorizeView>
