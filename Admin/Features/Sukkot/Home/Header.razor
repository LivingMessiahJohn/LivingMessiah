@using CrudEnums = Admin.Features.Sukkot.Home.RegistrationList.Enums.Crud

<div class="d-print-none d-flex justify-content-between align-items-center mb-3">

	<!-- Left side -->
	<div>
		@if (DetailPageHeaderVM is not null)
		{
			<span class="text-primary bg-light mb-0 p-2">
				<b>Receipt:</b> @DetailPageHeaderVM!.Value
			</span>
		}
	</div>

	<!-- Right side -->
	<div class="d-flex gap-2">
		<a class="btn btn-outline-secondary btn-sm" href="javascript:window.print()">
			<span class="fas fa-print me-1"></span> Print
		</a>

		<button @onclick="@ButtonClicked"
						class="btn btn-outline-secondary btn-sm">
			<i class="fas fa-chevron-up"></i> Registration List
		</button>
	</div>

</div>

@code {
	[Parameter, EditorRequired] public DetailPageHeaderVM? DetailPageHeaderVM { get; set; }
	[Parameter] public EventCallback OnShowListSelected { get; set; }

	private void ButtonClicked()
	{
		OnShowListSelected.InvokeAsync();
	}

}
