@page "/SukkotHome"
@page "/SukkotHome/{TabName}"

@using TabEnum = Admin.Features.Sukkot.Home.Enums.Tab
@using MenuBarEnums = Admin.Features.Sukkot.Enums.MenuBar
@using RoleGroup = Admin.Security.Enums.RoleGroup
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager NavigationManager

<AuthorizeView Policy=@RoleGroup.Sukkot>
  <Authorized>

    <PageTitle>
      @SelectedTab.Title
    </PageTitle>

    <ul class="nav nav-tabs mb-3 fs-6 my-tabs d-print-none" role="tablist">
      @foreach (var tab in TabEnum.List.OrderBy(t => t.Value))
      {
        <li class="nav-item" role="presentation">
          <button type="button"
                  class="nav-link @ActiveTab(tab)"
                  role="tab"
                  aria-selected="@(SelectedTab == tab)"
                  @onclick="() => SelectTab(tab)">
            <i class="@tab.Icon"></i>&nbsp; <span class="@tab.Css">@tab.Title</span>
          </button>
        </li>
      }
    </ul>

    @if (SelectedTab == TabEnum.Dashboard)
    {
      <Admin.Features.Sukkot.Dashboard.Main />
    }
    else if (SelectedTab == TabEnum.CRUD)
    {
      <Admin.Features.Sukkot.CRUD.Main />
    }
    else if (SelectedTab == TabEnum.DailySchedule)
    {
      <Admin.Features.Sukkot.DailySchedule.Main />
    }

  </Authorized>
  <NotAuthorized>
    <LoginRedirectCard ReturnTitle="@MenuBarEnums.Home.Title" ReturnUrl=@SelectedTab.Index />
    <div class="alert alert-warning text-end" role="alert">
      <small>Not Authorized; Role Group Policy: @RoleGroup.Sukkot</small>
    </div>
  </NotAuthorized>
</AuthorizeView>


@code {
  [Parameter] public string? TabName { get; set; }

  private TabEnum SelectedTab { get; set; } = TabEnum.Dashboard;

  protected override void OnParametersSet()
  {
    SelectedTab = ResolveTab(TabName);
  }

  private static TabEnum ResolveTab(string? tabName) =>
    !string.IsNullOrWhiteSpace(tabName) && TabEnum.TryFromName(tabName, ignoreCase: true, out var tab)
      ? tab
      : TabEnum.Dashboard;

  private string ActiveTab(TabEnum tab) => SelectedTab == tab ? "active" : "";

  private void SelectTab(TabEnum tab)
  {
    if (SelectedTab == tab) return;
    NavigationManager.NavigateTo(tab.Index);
  }
}
