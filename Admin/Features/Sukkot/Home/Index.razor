@page "/SukkotHome"

@using MenuBarEnums = Admin.Features.Sukkot.Enums.MenuBar;
@using RoleGroup = Admin.Security.Enums.RoleGroup;
@using Microsoft.AspNetCore.Components.Authorization


<AuthorizeView Policy=@RoleGroup.Sukkot>
  <Authorized>

    <PageTitle>
      @SelectedTab.Title
    </PageTitle>

    @* bg-secondary *@
    <ul class="nav nav-tabs mb-3 fs-6 my-tabs d-print-none" role="tablist">
      <li class="nav-item" role="presentation">
        <button type="button"
                class="nav-link @ActiveTab(MenuBarEnums.Dashboard)"
                role="tab"
                aria-selected="@(SelectedTab == MenuBarEnums.Dashboard)"
                @onclick="() => SelectTab(MenuBarEnums.Dashboard)">
          <i class="@MenuBarEnums.Dashboard.Icon"></i>&nbsp; <span class="@MenuBarEnums.Dashboard.Css">@MenuBarEnums.Dashboard.Title</span> 
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button type="button"
                class="nav-link @ActiveTab(MenuBarEnums.CRUD)"
                role="tab"
                aria-selected="@(SelectedTab == MenuBarEnums.CRUD)"
                @onclick="() => SelectTab(MenuBarEnums.CRUD)">
          <i class="@MenuBarEnums.CRUD.Icon"></i>&nbsp; <span class="@MenuBarEnums.CRUD.Css">@MenuBarEnums.CRUD.Title</span> 
        </button>
      </li>
      <li class="nav-item" role="presentation">

        <button type="button"
                class="nav-link @ActiveTab(MenuBarEnums.DailySchedule)"
                role="tab"
                aria-selected="@(SelectedTab == MenuBarEnums.DailySchedule)"
                @onclick="() => SelectTab(MenuBarEnums.DailySchedule)">
          <i class="@MenuBarEnums.DailySchedule.Icon"></i>&nbsp; <span class="@MenuBarEnums.DailySchedule.Css">@MenuBarEnums.DailySchedule.Title</span>
        </button>
      </li>

    </ul>

    @if (SelectedTab == MenuBarEnums.Dashboard)
    {
      <Admin.Features.Sukkot.Dashboard.Main />
    }
    else if (SelectedTab == MenuBarEnums.CRUD)
    {
      <Admin.Features.Sukkot.CRUD.Main />
    }
    else if (SelectedTab == MenuBarEnums.DailySchedule)
    {
      <Admin.Features.Sukkot.DailySchedule.Main />
    }

  </Authorized>
  <NotAuthorized>
    <LoginRedirectCard ReturnTitle="@MenuBarEnums.Home.Title" ReturnUrl=@MenuBarEnums.Home.Index />
    <div class="alert alert-warning text-end" role="alert">
      <small>Not Authorized; Role Group Policy: @RoleGroup.Sukkot</small>
    </div>
  </NotAuthorized>
</AuthorizeView>


@code {
  private MenuBarEnums SelectedTab { get; set; } = MenuBarEnums.Dashboard;

  private string ActiveTab(MenuBarEnums tab) => SelectedTab == tab ? "active" : "";

  private void SelectTab(MenuBarEnums tab) => SelectedTab = tab;
}
