@using NavEnums = Admin.Features.Sukkot.Dashboard.Enums.Nav;
@using SukkotHomeTab = Admin.Features.Sukkot.Home.Enums.Tab;

@inject NavigationManager NavigationManager

<div class="pb-1 mt-2 mb-3 border-bottom border-info">
	<div class="d-flex align-items-center">
		<!-- Optional left icon -->

		<!-- Centered title takes remaining space -->
		<div class="fs-3 text-center flex-grow-1">
			<i class="@MenuBar.Icon"></i>&nbsp;&nbsp;@MenuBar.Title
		</div>

		<!-- Button on the right -->
		<div class="d-flex gap-2">
			<button @onclick="@ButtonClicked"
							class="btn btn-outline-dark" type="button">
				<span class="me-2"><i class="fas fa-arrow-alt-circle-left"></i></span>
				Return To Dashboard
			</button>
		</div>


	</div>
</div>

@code {
	[Parameter, EditorRequired] public NavEnums MenuBar { get; set; }

	private void ButtonClicked()
	{
		NavigationManager!.NavigateTo(SukkotHomeTab.Dashboard.Index);
	}
}
