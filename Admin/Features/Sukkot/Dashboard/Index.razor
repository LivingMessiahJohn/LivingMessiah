@using RoleGroup = Admin.Security.Enums.RoleGroup;
@using NavEnums = Admin.Enums.Nav;
@using Microsoft.AspNetCore.Components.Authorization

@* ToDo: Can this Index.razor get deleted? *@

@page "/SukkotDashboard"

<AuthorizeView Policy=@RoleGroup.Sukkot>
	<Authorized>
		
		<PageHeaderChild NavEnum="@NavEnums.SukkotDashboard" />
		<Main />

	</Authorized>
	<NotAuthorized>
		
		@* ToDo: can this return to the SukkotDashboard page instead of SukkotHome page *@
		<LoginRedirectCard ReturnTitle="@NavEnums.SukkotDashboard.Title" ReturnUrl=@NavEnums.SukkotDashboard.Index />
		<div class="alert alert-warning text-end" role="alert">
			<small>Not Authorized; Role Group Policy: @RoleGroup.Sukkot</small>
		</div>

	</NotAuthorized>
</AuthorizeView>

