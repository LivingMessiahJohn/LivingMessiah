@page "/SukkotSchedule/PocketMod/PrintPreview8PagePDF"

@using NavEnums = Admin.Features.Sukkot.DailySchedule.Enums.Nav;
@using RoleGroup = Admin.Security.Enums.RoleGroup;
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using Admin.Features.Sukkot.DailySchedule
@using RCL.Features.Sukkot

@inject ILogger<PrintPreview8PagePDF> Logger

<AuthorizeView Policy=@RoleGroup.Sukkot>
	<Authorized>

		<PageTitle>@NavEnums.PocketModPrintPreview8PagePDF.Title</PageTitle>
		<DashboardHeader MenuBar="@NavEnums.PocketModPrintPreview8PagePDF" />

		<HeadContent>
			<style>
				@@page {
					size: legal portrait;
					margin: 0.4in;
				}

				@@media print {
					.footer,
					#blazor-error-ui {
						display: none !important;
					}

					.container-fluid {
						padding: 0 !important;
						margin: 0 !important;
					}
				}
			</style>
		</HeadContent>

		<div class="d-print-none d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
			<p class="text-muted mb-0">
				Print on <strong>Legal</strong> paper (8.5&nbsp;&times;&nbsp;14&nbsp;in). Eight pages: first is 10.md+11.md, last is 18.md+19.md.
			</p>
			<a class="btn btn-outline-secondary" title="Print" href="javascript:window.print()">
				<span class="fas fa-print"></span> Print
			</a>
		</div>

		<ScheduleWrapper8Pages />

	</Authorized>
	<NotAuthorized>
		<LoginRedirectCard ReturnTitle="@Nav.SukkotSchedule.Title" ReturnUrl=@Nav.SukkotSchedule.Index />
		<div class="alert alert-warning text-end" role="alert">
			<small>Not Authorized; Role Group Policy: @RoleGroup.Sukkot</small>
		</div>
	</NotAuthorized>
</AuthorizeView>


@code {

}
