@inject ILogger<DisplayCard>? Logger
@inject Data.IRepository? db;
@inject IToastService? Toast

@if (ShowPrintAnchor)
{
	<div class="d-print-none">
		<div class="row">
			<div class="col-12 d-flex justify-content-end">
				<button @onclick="@CancelActionHandler" class="@Constants.CancelButton.Color me-1">
					<i class="@Constants.CancelButton.Icon"></i> @Constants.CancelButton.Text
				</button>
				<a href="javascript:window.print()" class="@Constants.PrintButton.Color">
					<i class=" @Constants.PrintButton.Icon"></i> @Constants.PrintButton.Text
				</a>
			</div>
		</div>
	</div>
}

<LoadingComponentLIBRARY IsLoading="data == null" TurnSpinnerOff=TurnSpinnerOff>

	<SpecialEventDisplayCard EventDate="@data!.EventDate"
							 EventTypeId="@data.EventTypeId"
							 EventTypeDescr="@Enums.EventType.FromValue(data.EventTypeId).Descr"
							 Title="@data.Title"
							 SubTitle="@data.SubTitle"
							 ImageUrl="@data.ImageUrl"
							 YouTubeId="@data.YouTubeId"
							 WebsiteUrl="@data.WebsiteUrl"
							 WebsiteDescr="@data.WebsiteDescr"
							 Description="@data.Description" />

</LoadingComponentLIBRARY>

@code {
	[Parameter, EditorRequired] public int Id { get; set; }
	[Parameter] public bool ShowPrintAnchor { get; set; } = false;
	[Parameter] public EventCallback<ResponseRecord> OnResponseRecordChanged { get; set; } //

	bool TurnSpinnerOff = false;
	private FormVM? data;
	protected override async Task OnParametersSetAsync()
	{
		Logger!.LogDebug("{Method}", $"{nameof(Form)}!{nameof(OnParametersSetAsync)}");
		data = await db!.GetEventById(Id);
		try
		{
			data = await db!.GetEventById(Id);
			if (data == null)
			{
				Logger!.LogWarning("{Method} {Message}", nameof(OnParametersSetAsync), $"Id: {Id} not found");
				Toast!.ShowWarning($"data is null, {nameof(DisplayCard)}!{nameof(OnParametersSetAsync)} Id: {Id} not found");
			}
		}
		catch (Exception ex)
		{
			Logger!.LogError(ex, "{Method} {Message}", nameof(OnParametersSetAsync), $"Id: {data!.Id}");
			Toast!.ShowError($"{Global.ToastShowError} {nameof(DisplayCard)}!{nameof(OnParametersSetAsync)}");
		}
		TurnSpinnerOff = true;
	}

	protected ResponseRecord? responseRecord;
	protected async Task CancelActionHandler()
	{
		Logger!.LogDebug("{Method}", $"{nameof(DisplayCard)}!{nameof(CancelActionHandler)}");
		responseRecord = new(Enums.ResponseMessage.Success, "Action Canceled", RefreshList: true);
		await OnResponseRecordChanged.InvokeAsync(responseRecord);
	}

}
