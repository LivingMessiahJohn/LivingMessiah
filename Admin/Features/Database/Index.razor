@page "/Database"

@using Microsoft.AspNetCore.Components.Authorization
@using Admin.Security.Policies
@using Page = Admin.Enums.NavGroup


<PageHeader PageEnum="Page.Alerts" />

<AuthorizeView Policy=@Authentication.Name>
  <Authorized>
    <div class="alert alert-success text-end" role="alert">
      <small>Authorized: Policy: @Authentication.Name</small>
    </div>

    <AuthorizedSection />

  </Authorized>
  <NotAuthorized>
    <div class="alert alert-warning text-end" role="alert">   
      <small>Not Authorized; Policy: @Authentication.Name</small>
    </div>
    <LoginRedirectCard ReturnTitle="@Page.Alerts.Title" ReturnUrl="@Page.Alerts.Index" />
  </NotAuthorized>
</AuthorizeView>

@code {

}
