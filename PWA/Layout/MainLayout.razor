@using Toolbelt.Blazor.PWA.Updater
@using PWA.Layout.MenuNavbar
@using PWA.Constants

@inherits LayoutComponentBase
@inject Microsoft.JSInterop.IJSRuntime JsRuntime
@inject ILogger<MainLayout> Logger

<DomIdsInitializer />

<header>
	<div class="d-print-none">
		<div class="container-fluid px-0">
			<div class="d-flex align-items-center justify-content-between bg-primary text-white p-2 navbar navbar-dark">
				<div class="d-flex align-items-center gap-2">
					<HomeImgButton />
					<SearchButton />
					<ConnectionStatus />
				</div>
				<Title />
				<div class="d-flex align-items-center gap-2">
					<ThemeToggle />
					<OffcanvasToggler />
				</div>
			</div>
		</div>
			
		<div class="offcanvas offcanvas-end" tabindex="-1" id="@DomIds.Menu.OffCanvas"
				 aria-labelledby="@DomIds.Menu.OffCanvasLabel" style="width: 260px;">

			<div class="offcanvas-header">
				<h5 class="offcanvas-title" id="@DomIds.Menu.OffCanvasLabel">Menu</h5>
				<button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
			</div>

			<div class="offcanvas-body px-0">
				<nav class="nav flex-column">
					@foreach (var item in Enums.Nav.List.ToList()
													.Where(w => w.IsPartOfList(PageListType.TierOne))
													.OrderBy(o => o.Value))
					{
						<a class="nav-link px-3" href="@item.Index"><i class="@item.Icon"></i> @item.Title</a>
					}
				</nav>
			</div>
		</div>

		@* <Authorize /> <BlazoredToasts /> *@

		<PWAUpdater />
		@* <PWAUpdater State="PWAUpdater.States.Showing" /> *@

		<SearchModal />
		
	</div>

	<div class="d-none d-print-block">
		<Title />
	</div>

</header>

<div class="container-fluid px-0 px-sm-2">
	@* Catch component exceptions and show the real message on phones (no remote debugger needed). *@
	<ErrorBoundary @ref="_errorBoundary">
		<ChildContent>
			@Body
		</ChildContent>
		<ErrorContent Context="ex">
			<div class="blazor-error-boundary" role="alert">
				<div class="error-title">Something went wrong on this page</div>
				<div class="error-detail">@ex.GetType().Name: @ex.Message</div>
				<button type="button" class="btn btn-light btn-sm mt-2" @onclick="Recover">Try again</button>
			</div>
		</ErrorContent>
	</ErrorBoundary>
</div>

@* Keep a single blazor-error-ui in index.html for framework-level failures. *@

<footer class="text-muted">
	<Footer />
</footer>

@code {
	private ErrorBoundary? _errorBoundary;

	private void Recover() => _errorBoundary?.Recover();

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			try
			{
				// Initialize global keyboard shortcut to open the search modal (Ctrl+K / Cmd+K)
				await JsRuntime.InvokeVoidAsync("searchHotkeys.init");
			}
			catch (Exception ex)
			{
				// Missing site.js (stale service worker / partial cache) must not crash installed PWAs.
				Logger.LogWarning(ex, "searchHotkeys.init failed");
			}
		}
	}
}