@inject IJSRuntime JS
@inject ILogger<ConnectionStatus> Logger
@implements IAsyncDisposable

<a class="nav-link  ms-1 @GetBorder()" title="@GetTitle()">
	<i class="@GetIcon()"></i>
</a>

@code {
	private bool isOnline = true;
	private IJSObjectReference? moduleCleanup;

	private string GetBorder() => $"{(isOnline ? "" : " border border-2 border-danger rounded-2")}";
	private string GetIcon() => $"{(isOnline ? "fas fa-wifi" : "fas fa-slash")}";
	private string GetTitle() => $"{(isOnline ? "Online 👍" : "Offline 👎")}";

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await InitializeConnectionStatus();
		}
	}

	private async Task InitializeConnectionStatus()
	{
		try
		{
			// Get initial state
			isOnline = await JS.InvokeAsync<bool>("eval", "navigator.onLine");

			// Register event listeners
			var dotNetRef = DotNetObjectReference.Create(this);
			moduleCleanup = await JS.InvokeAsync<IJSObjectReference>(
					"connectionStatus.registerEvents",
					dotNetRef);

			StateHasChanged();
		}
		catch (Exception ex)
		{
			// Fallback to assuming online if check fails (missing connectivity.js under stale SW cache).
			Logger.LogWarning(ex, "ConnectionStatus init failed");
			isOnline = true;
		}
	}

	[JSInvokable]
	public void OnConnectionChanged(bool online)
	{
		isOnline = online;
		StateHasChanged();
	}

	public async ValueTask DisposeAsync()
	{
		if (moduleCleanup != null)
		{
			try
			{
				await moduleCleanup.InvokeVoidAsync("dispose");
				await moduleCleanup.DisposeAsync();
			}
			catch (Exception ex)
			{
				Logger.LogDebug(ex, "ConnectionStatus dispose failed");
			}
		}
	}
}
