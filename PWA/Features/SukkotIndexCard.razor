
<div class="card ">
	<div class="card-header bg-warning">
		<div class="text-center">
			<a href="https://sukkot.livingmessiah.com" class="ms-2" title="Sukkot.LivingMessiah.com">
				<img src="/images/sukkot-registration.svg" alt="Logo" class="sukkot-logo" />
			</a>
		</div>
	</div>
	<div class="footer mt-0">

		<span class="text-center @FontSize">
			<a href="https://Sukkot.LivingMessiah.com" target="_blank">
				<img src="/sukkot-favicon.ico" alt="Logo" width="32" height="32" class="rounded" />
				<u><b>Sukkot.LivingMessiah.com</b></u>
			</a>
			&nbsp;<i class="fas fa-arrow-right"></i>
		</span>
	</div>
</div>

@code {
	[Parameter, EditorRequired] public bool IsXs { get; set; }
	protected string FontSize => IsXs ? " fs-6" : "fs-4";
}