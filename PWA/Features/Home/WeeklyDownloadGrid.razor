@page "/WeeklyDownload"
@using Microsoft.AspNetCore.Components.QuickGrid
@using ParashaEnums = RCL.Features.Parasha.Enums
@using PWA.Features.Parasha

<PageHeader PageEnum="Nav.WeeklyDownload" BorderCSS="" />

<div class="card border-info p-3">

  <!-- Filter Input -->
  <div class="mb-3">
    <label class="form-label">Filter by <b>Complete Service</b>:</label>
    <div class="input-group" style="max-width: 200px;">
      <input type="text"
             class="form-control"
             placeholder="Type to filter filenames..."
             @bind="completeServiceFilter"
             @bind:after="ApplyFilter" />

      <button class="btn btn-outline-secondary"
              type="button"
              @onclick="ClearFilter"
              disabled="@string.IsNullOrEmpty(completeServiceFilter)">
        Clear
      </button>
    </div>
  </div>
  <QuickGrid Items="@filteredItems"
             TGridItem="ParashaEnums.Triennial"
             Pagination="@pagination">

    @* <PropertyColumn Title="Date" Property="@(p => p.DateOnly)" Sortable="true" /> *@

    <TemplateColumn Title="Complete Service" Sortable="false">
      <a class="text-decoration-none"
         target="_blank"
         href="@($"{baseUrl}{context.WeeklyReadingParashaFile}")"
         title="Download Complete Service PDF">
        @context.WeeklyReadingParashaFile
        <i class="fas fa-file-download ms-1" aria-hidden="true"></i>
      </a>
    </TemplateColumn>

    <TemplateColumn Title="Teach" Sortable="false">
      <a class="text-decoration-none"
         target="_blank"
         href="@($"{baseUrl}{context.WeeklyReadingParashaFileTeachingOnly}")"
         title="Download Teaching Only PDF">
        <i class="fas fa-file-download ms-1" aria-hidden="true"></i>
      </a>
    </TemplateColumn>

    <TemplateColumn Title="Haftorah / Brit">
      <span class="p-small-font">
        @context.HaftorahAbrv | @context.BritAbrv
      </span>
      @* @context.HaftorahAbrv <br /> @context.BritAbrv *@
    </TemplateColumn>

  </QuickGrid>

</div>

@code {
  string baseUrl = "https://livingmessiahstorage.blob.core.windows.net/shabbat-service/";

  PaginationState pagination = new PaginationState { ItemsPerPage = 30 };

  string? completeServiceFilter;

  IQueryable<ParashaEnums.Triennial> allItems = Enumerable.Empty<ParashaEnums.Triennial>().AsQueryable();

  IQueryable<ParashaEnums.Triennial> filteredItems =>
      string.IsNullOrEmpty(completeServiceFilter)
          ? allItems.OrderByDescending(o => o.DateOnly)
          : allItems.Where(p => p.WeeklyReadingParashaFile != null &&
                                p.WeeklyReadingParashaFile.Contains(completeServiceFilter!,
                                                                    StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(o => o.DateOnly);

  protected override void OnInitialized()
  {
    allItems = ParashaEnums.Triennial.List.AsQueryable();
  }

  private void ApplyFilter()
  {
    StateHasChanged();
  }

  private void ClearFilter()
  {
    completeServiceFilter = null;
    StateHasChanged();
  }
}