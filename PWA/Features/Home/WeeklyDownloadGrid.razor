@page "/WeeklyDownload"
@using Microsoft.AspNetCore.Components.QuickGrid
@using ParashaEnums = RCL.Features.Parasha.Enums
@using PWA.Features.Home.Shabbat.Constants

@* @using RCL.Features.Parasha.Helpers *@

<PageHeader PageEnum="Nav.WeeklyDownload" BorderCSS="" />

<div class="card border-info p-3">

	<div class="d-flex justify-content-between align-items-center mb-3">
		<div>
			<div class="input-group input-group-sm" style="max-width: 200px;">
				<input type="text"
							 class="form-control"
							 placeholder="Type to filter filenames..."
							 @bind="completeServiceFilter"
							 @bind:after="ApplyFilter" />

				<button class="btn btn-outline-secondary btn-sm"
								type="button"
								@onclick="ClearFilter"
								disabled="@string.IsNullOrEmpty(completeServiceFilter)">
					Clear
				</button>
			</div>
		</div>

		<div>
			<label class="me-2 mb-0">Items per page:</label>
			<select @onchange="OnItemsPerPageChanged" 
				class="form-select form-select-sm d-inline-block" style="width:auto;" 
				value="@selectedItemsPerPage">
				<option value="5">5</option>
				<option value="10">10</option>
				<option value="20">20</option>
				<option value="50">50</option>
				<option value="All">All</option>
			</select>
		</div>
	</div>

	<QuickGrid Items="@filteredItems"
						 TGridItem="ParashaEnums.Triennial"
						 Pagination="@pagination">

		<TemplateColumn Sortable="false">
			<HeaderTemplate>
				Complete Service <i class="fas fa-file-download ms-1"></i>
			</HeaderTemplate>
			<ChildContent>
				<a class="text-decoration-none"
					 target="_blank"
					 href="@($"{Blob.BaseUrl}{context.WeeklyReadingParashaFile}")"
					 title="Download Complete Service PDF">
					@context.WeeklyReadingParashaFile
				</a>
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Sortable="false">

			<HeaderTemplate>
				Teach Only <i class="fas fa-file-download ms-1"></i>
			</HeaderTemplate>
			<ChildContent>
			<a class="text-decoration-none"
				 target="_blank"
				 href="@($"{Blob.BaseUrl}{context.WeeklyReadingParashaFileTeachingOnly}")"
				 title="Download Teaching Only PDF">
				<b>@context.TorahAbrv</b> <span class="p-small-font">@context.HaftorahAbrv | @context.BritAbrv</span>
			</a>
			</ChildContent>
		</TemplateColumn>

	</QuickGrid>

	<Paginator State="pagination" />

</div>

@code {


	string? completeServiceFilter;

	IQueryable<ParashaEnums.Triennial> allItems = Enumerable.Empty<ParashaEnums.Triennial>().AsQueryable();

	IQueryable<ParashaEnums.Triennial> filteredItems =>
		string.IsNullOrEmpty(completeServiceFilter)
			? allItems.OrderByDescending(o => o.DateOnly).Where(w => w.DateOnly <= currentReadingDate)
			: allItems.Where(w => w.WeeklyReadingParashaFile != null &&
														w.WeeklyReadingParashaFile.Contains(completeServiceFilter!, StringComparison.OrdinalIgnoreCase) &&
														w.DateOnly <= currentReadingDate)
								.OrderByDescending(o => o.DateOnly);

	protected DateOnly currentReadingDate;
	protected override void OnInitialized()
	{
		//  Use the null-conditional operator (?.) to make GetCurrentReading()?.DateOnly nullable:
		currentReadingDate = RCL.Features.Parasha.Helpers.GetCurrentReading()?.DateOnly ?? DateOnly.MaxValue;
		allItems = ParashaEnums.Triennial.List.AsQueryable();
	}

	private void ApplyFilter()
	{
		StateHasChanged();
	}

	private void ClearFilter()
	{
		completeServiceFilter = null;
		StateHasChanged();
	}

	PaginationState pagination = new PaginationState { ItemsPerPage = 20 };
	string selectedItemsPerPage = "20";

	private void OnItemsPerPageChanged(ChangeEventArgs e)
	{
		selectedItemsPerPage = e?.Value?.ToString() ?? "20";

		if (selectedItemsPerPage == "All")
		{
			// Show all items by setting a very large page size
			pagination.ItemsPerPage = int.MaxValue;
		}
		else if (int.TryParse(selectedItemsPerPage, out var v))
		{
			pagination.ItemsPerPage = v;
		}

		StateHasChanged();
	}

}