@page "/WeeklyDownloadTable"

@using ParashaEnums = RCL.Features.Parasha.Enums

<PageHeader PageEnum="Nav.WeeklyDownload" />

<TableTemplate HeaderCSS="table table-sm table-warning table-hover"
							 Items="ParashaEnums.Triennial.List.OrderByDescending(o => o.DateOnly).ToList()">
	<TableHeader>
		<th>Id</th>
		<th class="text-start">Complete Service <i class="far fa-file-pdf" aria-hidden="true"></i></th>
		<th class="text-start">Teaching Only <i class="far fa-file-pdf" aria-hidden="true"></i></th>
	</TableHeader>
	<RowTemplate>
		<td>@context.Value</td>
		<td>
			<a class=""
				 target="_blank" title=""
				 href="@($"{baseUrl}{context.WeeklyReadingParashaFile}")">
				@context.WeeklyReadingParashaFile
				<i class="fas fa-file-download" aria-hidden="true"></i>
			</a>
		</td>

		<td>
			<a class=""
				 target="_blank" title=""
				 href="@($"{baseUrl}{context.WeeklyReadingParashaFileTeachingOnly}")">
				@context.WeeklyReadingParashaFileTeachingOnly
				<i class="fas fa-file-download" aria-hidden="true"></i>
			</a>
		</td>
	</RowTemplate>
</TableTemplate>

@code {

	string baseUrl = "https://livingmessiahstorage.blob.core.windows.net/shabbat-service/";

}
