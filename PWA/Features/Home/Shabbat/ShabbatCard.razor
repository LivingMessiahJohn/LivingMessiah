@using PWA.Enums

@using RCL.Features.Parasha.Enums

<div class="card border border-danger border-3 rounded-top text-center mb-3 mt-3">
	<div class="card-header bg-danger">
		<h2 class="text-center text-white ">Shabbat</h2>
	</div>

	<div class="card-body fs-5 py-3 bg-primary-subtle rounded-1 m-1 ">
		Worship service begins at: <span class="fw-bold" title="Arizona Time zone">3:00 pm</span>
	</div>

	<div class="card-body fs-5 py-3 bg-primary-subtle rounded-1 m-1 ">
		<a class="btn btn-outline-primary btn-lg"
			 href="@Nav.Liturgy.Index" title="Go to the @Nav.Liturgy.Title wizard">
			<i class="@Nav.Liturgy.Icon"></i>
			@Nav.Liturgy.Title &nbsp; <i class="fas fa-chevron-right"></i>
		</a>
	</div>

	<div class="card border border-primary border-2 rounded-top my-1 mx-1">

		<div class="card-header bg-primary fs-5 text-white">
			<b>Parasha:</b> @Parasha
		</div>

		<div class="card-body bg-primary-subtle ">

			<div class="row">

				<div class="col-4">
					@if (currentTriennial is null)
					{
						<Alert><code>currentTriennial is null</code></Alert>
					}
					else
					{
						<ButtonWrapper PdfType="@Enums.PdfType.CompleteService" />
					}
				</div>

				<div class="col-4">
					@if (currentTriennial is null)
					{
						<Alert><code>currentTriennial is null</code></Alert>
					}
					else
					{
						<ButtonWrapper PdfType="@Enums.PdfType.TeachingOnly" />
					}
				</div>

				<div class="col-4">
					<MarksWebsite />
				</div>


			</div>

		</div>
	</div>

	<div class="card-footer bg-dark-subtle ">

		<a class="btn btn-outline-primary"
			 href="@Nav.WeeklyDownload.Index" title="see previous parasha Teachings">
			<i class="@Nav.WeeklyDownload.Icon"></i> &nbsp;
			@Nav.WeeklyDownload.Title &nbsp; <i class="fas fa-chevron-right"></i>
			@* 			<br />	<span class="d-inline-block mb-0 px-2 p-small-font text-muted bg-warning-subtle">see previous parasha Teachings</span> *@
		</a>

	</div>


</div>



@code {

	string? Parasha;

	Triennial? currentTriennial;
	protected override async Task OnInitializedAsync()
	{
		currentTriennial = RCL.Features.Parasha.Helpers.GetCurrentReading();
		if (currentTriennial is null)
		{
			Parasha = "NOT FOUND";
		}
		else
		{
			Parasha = currentTriennial.Date.ToString("yyyy MMMM dd") + " | " + currentTriennial.BCV;
		}
	}
}
