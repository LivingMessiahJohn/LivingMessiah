@using PWA.Enums
@using PWA.Features.Home.Shabbat.Teaching
@using PWA.Features.Home.Shabbat.Teaching.Enums
@using RCL.Features.Parasha.Enums

<div class="card border border-danger border-3 rounded-top text-center mb-3 mt-3">

	<div class="card-header bg-danger">
		<h2 class="text-center text-white ">Shabbat</h2>
	</div>

	<div class="card-body fs-5 py-3 bg-primary-subtle rounded-1 m-1 ">
		Worship service begins at: <span class="fw-bold" title="Arizona Time zone">3:00 pm</span>
	</div>

	<div class="card-body fs-5 py-3 bg-primary-subtle rounded-1 m-1 ">
		<a class="btn btn-outline-primary btn-lg"
			 href="@Nav.Liturgy.Index" title="Go to the @Nav.Liturgy.Title wizard">
			<i class="@Nav.Liturgy.Icon"></i>
			@Nav.Liturgy.Title &nbsp; <i class="fas fa-chevron-right"></i>
		</a>
	</div>

	<div class="card border border-primary border-2 rounded-top my-1 mx-1">
		<ParashaHeader Triennial="@Triennial" />

		<div class="card-body bg-primary-subtle ">
			<div class="row g-1">

				<div class="col-4">
					<ButtonWrapper PdfType="@PdfType.CompleteService" Triennial="@Triennial" />
				</div>

				<div class="col-4">
					<ButtonWrapper PdfType="@PdfType.TeachingOnly" Triennial="@Triennial" />
				</div>

				<div class="col-4">
					<MarksWebsite />
				</div>

			</div>
		</div>

		<div class="bg-primary-subtle p-1 border-top border-dark-subtle">
			<ArchiveGrid Triennial="@Triennial" />
		</div>

	</div>

</div>

@code {

	Triennial? Triennial;


	/*
	 ToDo: can this be a non async method?  It is just a calculation based on the current date.
	 The argument for it is that ButtonWrapper is async because it calls `await BlobApiService.GetParasha(null, PdfType);`
	 
	*/
	protected override async Task OnInitializedAsync()
	{
		Triennial = RCL.Features.Parasha.Helpers.GetCurrentReading();
	}
}
