@using Microsoft.AspNetCore.Components.QuickGrid
@using ParashaEnums = RCL.Features.Parasha.Enums
@using PWA.Features.Home.Shabbat.Teaching.Constants

<div class="d-flex justify-content-between">
	<span class="text-dark pt-1">
		<i class="far fa-file-pdf fa-fw fa-2x"></i>
	</span>
	<span class="fs-5 text-primary text-center fw-bold pt-1">PDF Archive</span>
	<ShowHideGridToggle ContentIsShowing="ShowingDetails"
											OnToggleSelected="ReturnedToggle" />
</div>

@if (ShowingDetails)
{
	<hr />

	<div class="d-flex justify-content-between align-items-center mb-3">
		<div>
			<div class="input-group input-group-sm" style="max-width: 200px;">
				<input type="text"
							 class="form-control"
							 placeholder="Type to filter filenames..."
							 @bind="completeServiceFilter"
							 @bind:after="ApplyFilter" />

				<button class="btn btn-outline-secondary btn-sm"
								type="button"
								@onclick="ClearFilter"
								disabled="@string.IsNullOrEmpty(completeServiceFilter)">
					Clear
				</button>
			</div>
		</div>

		<div style="font-size: 75%;">
			<label for="itemsPerPage" class="me-2 mb-0">Items / page</label>
			<select id="itemsPerPage" name="itemsPerPage"
							@onchange="OnItemsPerPageChanged"
							class="form-select form-select-sm d-inline-block" style="width:auto;"
							value="@selectedItemsPerPage">
				<option value="5">5</option>
				<option value="10">10</option>
				<option value="20">20</option>
				<option value="50">50</option>
				<option value="All">All</option>
			</select>
		</div>
	</div>

	<QuickGrid Items="@filteredItems"
						 TGridItem="ParashaEnums.Triennial"
						 Pagination="@pagination">

		<TemplateColumn Sortable="false">

			<HeaderTemplate>
				<span class="@headerTemplate">Teaching Only <i class="fas fa-file-download ms-1"></i></span>
			</HeaderTemplate>
			<ChildContent>
				<a class="@anchorClass"
					 target="_blank"
					 href="@($"{Blob.BaseUrl}{context.WeeklyReadingParashaFileTeachingOnly}")"
					 title="Download Teaching Only PDF">
					@* <b>@context.TorahAbrv</b> <span class="p-small-font">@context.HaftorahAbrv | @context.BritAbrv</span> *@
					<b>@context.TorahAbrv</b>
				</a>
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Sortable="false">
			<HeaderTemplate>
				<span class="@headerTemplate">
					Complete Service <i class="fas fa-file-download ms-1"></i>
				</span>
			</HeaderTemplate>
			<ChildContent>
				<a class="@anchorClass"
					 target="_blank"
					 href="@($"{Blob.BaseUrl}{context.WeeklyReadingParashaFile}")"
					 title="Download Complete Service PDF">
					@context.WeeklyReadingParashaFile
				</a>
			</ChildContent>
		</TemplateColumn>
	</QuickGrid>

	<Paginator State="pagination" />
}


@code {
	[Parameter, EditorRequired] public ParashaEnums.Triennial? Triennial { get; set; }

	//const string headerTemplate = "border border-bottom border-2";
	const string headerTemplate = "text-primary fw-bold pb-1 border-bottom border-primary border-2";
	// Class="table table-striped table-hover"
	//const string anchorClass = "btn btn-sm py-0 m-0 btn-link";
	const string anchorClass = "text-decoration-none";
	//const string anchorClass = "btn btn-xs btn-outline-primary";

	string? completeServiceFilter;

	IQueryable<ParashaEnums.Triennial> allItems = Enumerable.Empty<ParashaEnums.Triennial>().AsQueryable();

	IQueryable<ParashaEnums.Triennial> filteredItems =>
		string.IsNullOrEmpty(completeServiceFilter)
			? allItems.OrderByDescending(o => o.DateOnly).Where(w => w.DateOnly <= currentReadingDate)
			: allItems.Where(w => w.WeeklyReadingParashaFile != null &&
														w.WeeklyReadingParashaFile.Contains(completeServiceFilter!, StringComparison.OrdinalIgnoreCase) &&
														w.DateOnly <= currentReadingDate)
								.OrderByDescending(o => o.DateOnly);

	protected DateOnly currentReadingDate;
	protected override void OnInitialized()
	{
		//  Use the null-conditional operator (?.) to make GetCurrentReading()?.DateOnly nullable:
		currentReadingDate = RCL.Features.Parasha.Helpers.GetCurrentReading()?.DateOnly ?? DateOnly.MaxValue;
		allItems = ParashaEnums.Triennial.List.AsQueryable();
	}

	private void ApplyFilter()
	{
		StateHasChanged();
	}

	private void ClearFilter()
	{
		completeServiceFilter = null;
		StateHasChanged();
	}

	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };
	string selectedItemsPerPage = "5";

	private void OnItemsPerPageChanged(ChangeEventArgs e)
	{
		selectedItemsPerPage = e?.Value?.ToString() ?? selectedItemsPerPage;

		if (selectedItemsPerPage == "All")
		{
			// Show all items by setting a very large page size
			pagination.ItemsPerPage = int.MaxValue;
		}
		else if (int.TryParse(selectedItemsPerPage, out var v))
		{
			pagination.ItemsPerPage = v;
		}

		StateHasChanged();
	}

	#region ShowHideToggle
	bool ShowingDetails = false;

	private async Task ReturnedToggle()
	{
		ShowingDetails = !ShowingDetails;
	}

	#endregion

}