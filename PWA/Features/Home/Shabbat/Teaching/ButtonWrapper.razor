@using PWA.Features.Home.Shabbat.Teaching.Data
@using PWA.Features.Home.Shabbat.Teaching.Enums
@using ParashaEnums = RCL.Features.Parasha.Enums

@inject Data.IBlobApiService BlobApiService
@inject ILogger<ButtonWrapper>? Logger


@if (Triennial is null)
{
	<button class="@ButtonCSS" disabled title="Current parasha is null">
		<span class="@FontSize">No Parasha</span>
		<i class="@FontCSS" aria-hidden="true"></i>
	</button>
	<p class="p-small-font text-muted bg-warning-subtle"><code>Triennial is null</code></p>
}
else
{
	@if (ExceptionOccurred)
	{
		@* <div class="card-body text-center mt-0"> *@
			<button class="@ButtonCSS" disabled title="File not available">
			<span class="@FontSize">@PdfTypeHelper.GetPdfTypeText(Dto?.PdfType)</span>
				<i class="@FontCSS" aria-hidden="true"></i>
			</button>
			<p class="p-small-font text-muted bg-warning-subtle"><code>ExceptionOccurred</code></p>
		@* </div> *@
	}
	else
	{
		@if (Dto is not null)
		{
			@* <div class="card-body text-center mt-0"></div> *@
				<PdfDownloadButton Dto="@Dto" />
		}
	}

}

@code {

	[Parameter, EditorRequired] public PdfType PdfType { get; set; }
	[Parameter, EditorRequired] public ParashaEnums.Triennial? Triennial { get; set; }

	protected string FontSize = "fs-6";
	const string ButtonCSS = "btn btn-outline-danger ";
	const string FontCSS = "fas fa-file-download";

	protected BlobDTO? Dto;
	bool ExceptionOccurred = false; 

	// ToDo: way to much code
	protected override async Task OnInitializedAsync()
	{
		Logger!.LogInformation("{Method}, {Message}", $"{nameof(ButtonWrapper)}!{nameof(OnInitializedAsync)}", $"Start, PdfType:{PdfType}	");
		try
		{
			await Task.Delay(200);
			Dto = await BlobApiService.GetParasha(null, PdfType);

			if (Dto is null)
			{
				Logger!.LogError("{Method}, Dto is null", nameof(OnInitializedAsync));
				ExceptionOccurred = true;
			}
			else
			{
				if (Dto?.ExceptionOccurred == true)
				{
					Logger!.LogError("{Method}, Dto.ExceptionOccurred is TRUE", nameof(OnInitializedAsync));
					ExceptionOccurred = true;
				}
				else
				{
					Logger!.LogInformation("{Method}, {Message}",
						nameof(OnInitializedAsync), $"Url: {Dto!.Url}, Exists: {Dto!.Exists}, Parasha: {Dto!.Parasha}");
				}
			}
		}
		catch (Exception ex)
		{
			Logger!.LogError(ex, "{Method}", nameof(OnInitializedAsync));
			ExceptionOccurred = true;
		}

		Logger!.LogInformation("{Method}, {Message}", $"{nameof(ButtonWrapper)}!{nameof(OnInitializedAsync)}", "FINISHED!!!");
	}


}
