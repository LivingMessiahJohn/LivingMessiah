@using PWA.Features.Home.Shabbat.Teaching.Data
@using ParashaEnums = RCL.Features.Parasha.Enums
@using RCL.Features.Parasha

@inject Data.IBlobApiService BlobApiService
@inject ILogger<ButtonWrapper> Logger
@inject IJSRuntime JS


@if (Triennial is null)
{
	<button class="@ButtonCSS" disabled title="Current parasha is not available">
		<span class="@FontSize">No Parasha</span>
		<i class="@FontCSS" aria-hidden="true"></i>
	</button>
}
else if (_loading)
{
	<button class="@ButtonCSS" disabled title="Checking PDF availability">
		<span class="@FontSize">@Helpers.GetPdfTypeText(PdfType)</span>
		<span class="spinner-border spinner-border-sm ms-1" role="status" aria-hidden="true"></span>
	</button>
}
else if (ExceptionOccurred)
{
	<button class="@ButtonCSS" disabled title="@_disabledTitle">
		<span class="@FontSize">@Helpers.GetPdfTypeText(PdfType)</span>
		@if (_isOffline)
		{
			<i class="fas fa-wifi" aria-hidden="true" title="Offline"></i>
			<span class="visually-hidden">Offline</span>
		}
		else
		{
			<i class="@FontCSS" aria-hidden="true"></i>
		}
	</button>
}
else if (Dto is not null)
{
	<PdfDownloadButton Dto="@Dto" />
}

@code {

	[Parameter, EditorRequired] public ParashaEnums.PdfType PdfType { get; set; }
	[Parameter, EditorRequired] public ParashaEnums.Triennial? Triennial { get; set; }

	protected string FontSize = "fs-6";
	const string ButtonCSS = "btn btn-outline-danger ";
	const string FontCSS = "fas fa-file-download";

	protected BlobDTO? Dto;
	bool ExceptionOccurred;
	bool _loading = true;
	bool _isOffline;
	string _disabledTitle = "File not available";

	protected override async Task OnInitializedAsync()
	{
		Logger.LogInformation("{Method}, Start, PdfType:{PdfType}",
			$"{nameof(ButtonWrapper)}!{nameof(OnInitializedAsync)}", PdfType);

		try
		{
			try
			{
				_isOffline = !await JS.InvokeAsync<bool>("eval", "navigator.onLine ?? true");
			}
			catch
			{
				_isOffline = false;
			}

			if (_isOffline)
			{
				ExceptionOccurred = true;
				_disabledTitle = "Offline — PDF check unavailable";
				return;
			}

			Dto = await BlobApiService.GetParasha(Triennial, PdfType);

			if (Dto is null || Dto.ExceptionOccurred)
			{
				Logger.LogWarning("{Method}, blob lookup failed or returned exception flag", nameof(OnInitializedAsync));
				ExceptionOccurred = true;
				_disabledTitle = "PDF temporarily unavailable";
			}
			else
			{
				Logger.LogInformation("{Method}, Url: {Url}, Exists: {Exists}, Parasha: {Parasha}",
					nameof(OnInitializedAsync), Dto.Url, Dto.Exists, Dto.Parasha);
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "{Method}", nameof(OnInitializedAsync));
			ExceptionOccurred = true;
			_disabledTitle = "PDF temporarily unavailable";
		}
		finally
		{
			_loading = false;
		}
	}
}
