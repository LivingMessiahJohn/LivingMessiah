@using PWA.Features.Home.Shabbat.Teaching.Data
@using RCL.Features.Parasha

@* Caller (ButtonWrapper) only renders this when Dto.Exists is true. *@
@if (Dto is not null && Dto.Exists)
{
	<a class="btn btn-success"
		 target="_blank" title="Pdf @Dto.Url"
		 href="@Dto.Url">
		<span class="fs-6">@Helpers.GetPdfTypeText(Dto.PdfType)</span>
		<i class="fas fa-file-download" aria-hidden="true"></i>
	</a>
}

@code {
	[Parameter, EditorRequired] public BlobDTO Dto { get; set; } = default!;
}
