@using PWA.Helpers

@if (ShowPrintAnchor)
{
	<div class="d-print-none">
		<div class="row">
			<div class="col-12 d-flex justify-content-end">

				<a href="javascript:window.print()">
					<i class="fa fa-print"></i> Print
				</a>
			</div>
		</div>
	</div>
}

<div class="card border-primary my-1">

	<div class="card-header text-center bg-info-subtle">
		<h2 class="text-center text-black">Upcoming Events</h2>
	</div>

	<div class="card-header">

		<div class="row">
			<div class="col-6">
				<h4>
					<i class="far fa-calendar"></i>
					<span class='badge bg-primary'>@FormVM!.EventDate.ToString(DateFormat.ddd_mm_dd)</span>
				</h4>
			</div>
			<div class="col-6 text-end">
				Type: <b> @(FormVM.EventTypeDescr ?? $"Type {FormVM.EventTypeId}") </b>
			</div>
		</div>

	</div>

	<div class="card-body">
		<h3 class="card-text text-center">
			@FormVM.Title
		</h3>

		@if (!String.IsNullOrEmpty(@FormVM.SubTitle))
		{
			<h5 class="card-title text-center">@FormVM.SubTitle</h5>
		}

	</div>

	<div class="card-body">
		@if (!String.IsNullOrEmpty(@FormVM.ImageUrl))
		{
			<img src='@FormVM.ImageUrl' alt="@FormVM.ImageUrl" class="img-fluid rounded mt-2 d-block mx-auto" />
		}
		else
		{
			@* <img src='@Constants.Blobs.EventsLink("special-event-template.jpg")' alt="special event" class="img-fluid rounded mt-4 mx-auto d-block" />	*@
		}
	</div>

	<div class="card-body">

		@if (!String.IsNullOrEmpty(@FormVM.YouTubeId))
		{
			<a href="https://www.youtube.com/watch?v=@FormVM.YouTubeId" target="_blank" title="@FormVM.YouTubeId">
				<img src='https://img.youtube.com/vi/@FormVM.YouTubeId/mqdefault.jpg' class='mt-4' /> <br>  @FormVM.Title
			</a>
		}

		@if (!String.IsNullOrEmpty(@FormVM.WebsiteUrl))
		{
			<Anchor Href="@FormVM.WebsiteUrl" TargetIsBlank="true" Descr="@FormVM.WebsiteDescr" />
		}

		@if (!String.IsNullOrEmpty(@FormVM.Description))
		{
			<div class="card-body bg-info-subtle markdown-body">
				@MarkdownHelper.ToMarkup(FormVM.Description)
			</div>
		}

	</div>

</div>

@code {
	[Parameter, EditorRequired] public FormVM? FormVM { get; set; }
	[Parameter] public bool ShowPrintAnchor { get; set; } = false;
}
