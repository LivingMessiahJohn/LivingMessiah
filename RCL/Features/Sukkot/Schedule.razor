@using RCL.Constants
@using RCL.Helpers

<div class="card border border-warning border-4 bg-warning-subtle mt-4">
	<h2 class="py-2 text-center text-black"><b>Schedule</b></h2>

	@if (ScheduleQuery is null || string.IsNullOrWhiteSpace(ScheduleQuery.Markdown))
	{
		<div class="card-body">
			<p class="text-center mb-0">Schedule is not available yet.</p>
		</div>
	}
	else
	{
		<div class="card-body markdown-body">
			@MarkdownHelper.ToMarkup(ScheduleQuery!.Markdown)
		</div>
		<div class="card-footer text-end small text-muted bg-warning-subtle border-0">
			Last revised: @ScheduleQuery!.LastRevised.ToString(DateFormat.ddd_MMM_dd_YYYY)
		</div>
	}
</div>

@code {
	[Parameter] public ScheduleQuery? ScheduleQuery { get; set; }

}
