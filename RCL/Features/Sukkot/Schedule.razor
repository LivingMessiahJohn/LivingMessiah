@using RCL.Helpers
@using RCL.Features.Sukkot.Data.DailySchedule

<div class="card border border-warning border-4 bg-warning-subtle mt-4">
	<h2 class="py-2 text-center text-black"><b>Schedule</b></h2>

	@if (Days is null || Days.Length == 0)
	{
		<div class="card-body">
			<p class="text-center mb-0">Schedule is not available yet.</p>
		</div>
	}
	else
	{
		<nav class="navbar navbar-expand bg-primary-subtle">
			<div class="collapse navbar-collapse justify-content-between">
				<div class="mx-1">
					@if (!IsFirst)
					{
						<button type="button" class="btn btn-outline-primary btn-md" title="Previous day" @onclick="ShowPrevious">
							<i class="fas fa-arrow-left"></i>
						</button>
					}
					else
					{
						<button type="button" class="btn btn-light btn-md disabled" aria-disabled="true">
							<span class="text-black-50"><i class="fas fa-ban"></i></span>
						</button>
					}
				</div>

				<div class="col">
					<div class="progress" style="height: 40px;"
							 role="progressbar"
							 aria-valuenow="@(_index + 1)"
							 aria-valuemin="1"
							 aria-valuemax="@Days.Length"
							 aria-label="@CurrentTitle">
						@if (ProgressPercent < 50)
						{
							<div class="progress-bar bg-info text-dark" style="@ProgressStyle"></div>
							<span class="fs-5 fw-bold mt-2">&nbsp;@CurrentTitle</span>
						}
						else
						{
							<div class="progress-bar bg-info text-dark" style="@ProgressStyle">
								<span class="fs-5 fw-bold mt-2 float-end">@CurrentTitle</span>
							</div>
						}
					</div>
				</div>

				<div class="ms-1">
					@if (!IsLast)
					{
						<button type="button" class="btn btn-outline-primary btn-md" title="Next day" @onclick="ShowNext">
							<i class="fas fa-arrow-right"></i>
						</button>
					}
					else
					{
						<button type="button" class="btn btn-light btn-md disabled" aria-disabled="true">
							<span class="text-black-50"><i class="fas fa-ban"></i></span>
						</button>
					}
				</div>
			</div>
		</nav>

		<div class="card-body markdown-body">
			@MarkdownHelper.ToMarkup(CurrentDay?.Markdown)
		</div>
	}
</div>

@code {
	[Parameter] public MarkdownRecord[] Days { get; set; } = [];

	private int _index;
	private MarkdownRecord[] _boundDays = [];

	private MarkdownRecord? CurrentDay =>
		Days is { Length: > 0 } && _index >= 0 && _index < Days.Length
			? Days[_index]
			: null;

	private string CurrentTitle =>
		CurrentDay is null ? string.Empty : DailyEventFiles.TitleFor(CurrentDay);

	private bool IsFirst => _index <= 0;
	private bool IsLast => Days is null || Days.Length == 0 || _index >= Days.Length - 1;

	private int ProgressPercent =>
		Days is { Length: > 0 } ? ((_index + 1) * 100) / Days.Length : 0;

	private string ProgressStyle => $"width:{ProgressPercent}%";

	protected override void OnParametersSet()
	{
		if (Days is null || Days.Length == 0)
		{
			_boundDays = [];
			_index = 0;
			return;
		}

		if (!ReferenceEquals(Days, _boundDays))
		{
			_boundDays = Days;
			_index = DailyEventFiles.IndexForToday(Days);
			if (_index < 0 || _index >= Days.Length)
				_index = 0;
		}
	}

	private void ShowPrevious()
	{
		if (_index > 0)
			_index--;
	}

	private void ShowNext()
	{
		if (Days is { Length: > 0 } && _index < Days.Length - 1)
			_index++;
	}
}
